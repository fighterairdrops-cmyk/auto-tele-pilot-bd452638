# Railway Postgres connection string (Variables → Postgres → DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Public https URL of this Railway service (Settings → Networking → Generate Domain).
# Railway also provides RAILWAY_PUBLIC_DOMAIN automatically, which is used as fallback.
PUBLIC_URL=https://your-service.up.railway.app

# Protects /admin/* endpoints. Use any long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional tuning
AUTO_SET_WEBHOOK=true
POSTS_INTERVAL_MS=30000
DELETES_INTERVAL_MS=30000
SUMMARY_HOUR_UTC=9
